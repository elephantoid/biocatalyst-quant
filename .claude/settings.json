{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*secret*)",
      "Read(./**/*credential*)",
      "Bash(git diff --no-index*)",
      "Bash(git diff *--output*)",
      "Bash(git diff *--ext-diff*)",
      "Bash(cat *.env*)",
      "Bash(* .env)"
    ],
    "allow": [
      "Bash(git status --short)",
      "Bash(git status --porcelain)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --name-only)",
      "Bash(uv run --no-sync ruff check .)",
      "Bash(uv run --no-sync ruff format --check .)",
      "Bash(uv run --no-sync mypy src)",
      "Bash(uv run --no-sync pytest -q tests/unit)",
      "Bash(uv run --no-sync pytest -q tests/integration)"
    ]
  }
}
